# Copy to .env and fill in. .env is gitignored; never commit real values.

# Frontend (Vite, client-side). The anon/publishable key is public by design —
# RLS + Edge Functions are the security boundary, not the key.
#
# Production values (baked in by CI from GitHub repo variables):
#   VITE_SUPABASE_URL=https://games-api.kh3dron.net
# Local dev against the selfhost stack (see selfhost/README.md):
#   VITE_SUPABASE_URL=http://127.0.0.1:8000
# The anon key is ANON_KEY from selfhost/.env in both cases.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
