# Reference for selfhost/.env. Do NOT fill this in by hand - run
#   node scripts/generate-secrets.mjs
# which writes .env with fresh secrets and these config values. .env is
# gitignored; rotating JWT_SECRET invalidates all sessions AND both API keys
# (the frontend build + GitHub repo variables must be updated to match).

############ Secrets (generated) ############
POSTGRES_PASSWORD=<generated>
JWT_SECRET=<generated 64-hex>
ANON_KEY=<HS256 JWT, role=anon, signed with JWT_SECRET>
SERVICE_ROLE_KEY=<HS256 JWT, role=service_role - never ships to clients>
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=<generated>
SECRET_KEY_BASE=<generated 64 chars>
REALTIME_DB_ENC_KEY=<generated 16 chars>
VAULT_ENC_KEY=<generated 32 chars>
PG_META_CRYPTO_KEY=<generated 32 chars>
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

############ URLs ############
SUPABASE_PUBLIC_URL=https://games-api.kh3dron.net
API_EXTERNAL_URL=https://games-api.kh3dron.net/auth/v1
SITE_URL=https://games.kh3dron.net
ADDITIONAL_REDIRECT_URLS=https://games.kh3dron.net/**,http://localhost:5173/**,http://localhost:4173/**

############ Database ############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ Auth ############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# No SMTP: signups auto-confirm; magic links fail until SMTP_* are set.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=topologic-go
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

############ Edge Functions ############
FUNCTIONS_VERIFY_JWT=false

############ PostgREST ############
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############ Kong / Studio ############
KONG_HTTP_PORT=8000
STUDIO_DEFAULT_ORGANIZATION=topologic-go
STUDIO_DEFAULT_PROJECT=topologic-go

############ Web Push (per-move notifications) ############
# Generate: node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'P-256'});const p=publicKey.export({format:'jwk'});const d=privateKey.export({format:'jwk'});console.log('pub',Buffer.concat([Buffer.from([4]),Buffer.from(p.x,'base64url'),Buffer.from(p.y,'base64url')]).toString('base64url'));console.log('priv',d.d)"
# Public key also goes to the frontend build as VITE_VAPID_PUBLIC_KEY.
# Empty = push disabled (moves still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
